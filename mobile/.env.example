# Environment Configuration
# Copy this file to .env and fill in the values

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_API_TIMEOUT=30000

# App Configuration
EXPO_PUBLIC_APP_NAME=Truyện Plus
EXPO_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_ENABLE_AUDIO_PLAYER=true
EXPO_PUBLIC_ENABLE_COMMENTS=false
EXPO_PUBLIC_ENABLE_RATINGS=false
EXPO_PUBLIC_ENABLE_PREMIUM=false
EXPO_PUBLIC_ENABLE_ADS=false

# Analytics (Phase 3+)
# EXPO_PUBLIC_ANALYTICS_KEY=

# Supabase (Phase 2+)
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
